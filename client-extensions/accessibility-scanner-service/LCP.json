{
	"cpu": 1,
	"env": {
		"LIFERAY_ROUTES_CLIENT_EXTENSION": "/etc/liferay/lxc/ext-init-metadata",
		"LIFERAY_ROUTES_DXP": "/etc/liferay/lxc/dxp-metadata"
	},
	"id": "accessibilityscannerservice",
	"kind": "Deployment",
	"livenessProbe": {
		"httpGet": {
			"path": "/health",
			"port": 58082
		}
	},
	"loadBalancer": {
		"cdn": false,
		"targetPort": 58082
	},
	"memory": 2048,
	"readinessProbe": {
		"httpGet": {
			"path": "/health",
			"port": 58082
		}
	},
	"scale": 1
}
